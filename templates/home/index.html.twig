{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Gestion & Firmware OTA{% endblock %}

{% block body %}

<div class="container py-4">
    {# En-tête de bienvenue #}
    <div class="p-4 mb-4 bg-white rounded-3 shadow-sm border-start border-4" style="border-color: #D4AF37 !important;">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h2 class="fw-bold mb-1" style="color: #0F172A;">
                    <i class="fas fa-microchip me-2" style="color: #D4AF37;"></i>Tableau de Bord Trésorerie & Système
                </h2>
                <p class="text-muted mb-0">Gestion centralisée, modules de suivi et téléversement des firmwares (OTA).</p>
            </div>
            <span class="badge px-3 py-2 text-white shadow-sm" style="background-color: #0F172A;">
                <i class="fas fa-circle text-success me-1"></i> Système Actif
            </span>
        </div>
    </div>

    {# Carte d'action : Téléversement Firmware OTA #}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
                
                {# En-tête de la carte #}
                <div class="card-header py-3 d-flex align-items-center justify-content-between" style="background-color: #1653e2; border-bottom: 3px solid #504112;">
                    <h5 class="mb-0 text-white font-weight-bold">
                        <i class="fas fa-upload me-2" style="color: #e0d5b0;"></i>Mise à jour Firmware (OTA) ENCODER
                    </h5>
                    <span class="badge bg-warning text-dark">ESP32 / ESP8266</span>
                </div>

                {# Corps de la carte #}
                <div class="card-body p-4 text-center bg-white">
                    <div class="my-3">
                        <i class="fas fa-file-code fa-3x mb-3" style="color: #132c66;"></i>
                        <h5 class="fw-bold text-dark">Téléverser un nouveau firmware "ENCODER"</h5>
                        <p class="text-muted small">
                            Sélectionnez et envoyez un fichier binaire (<code>.bin</code>) pour mettre à jour vos modules distants en toute sécurité.
                        </p>
                    </div>

                    {# Actions en boutons Bootstrap (Remplacement de la balise dialog/menu native) #}
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="#" class="btn btn-outline-secondary px-4 font-weight-bold">
                            <i class="fas fa-times me-1"></i> Annuler
                        </a>
                        <a href="{{ path('app_ota_upload') }}" class="btn text-white font-weight-bold shadow-sm px-4" style="background-color: #0F172A; border-left: 3px solid #D4AF37;">
                            <i class="fas fa-cloud-upload-alt me-2" style="color: #D4AF37;"></i> Téléverser
                        </a>
                    </div>
                </div>

                {# Pied de carte #}
                <div class="card-footer bg-light p-3 text-center">
                    <small class="text-muted"><i class="fas fa-shield-alt me-1 text-primary"></i> Transfert sécurisé via HTTPS / TLS</small>
                </div>

            </div>
        </div>
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
                
                {# En-tête de la carte #}
                <div class="card-header py-3 d-flex align-items-center justify-content-between" style="background-color: #0F172A; border-bottom: 3px solid #D4AF37;">
                    <h5 class="mb-0 text-white font-weight-bold">
                        <i class="fas fa-upload me-2" style="color: #D4AF37;"></i>Mise à jour Firmware (OTA) "SERVER SMS"
                    </h5>
                    <span class="badge bg-warning text-dark">ESP32 / ESP8266</span>
                </div>

                {# Corps de la carte #}
                <div class="card-body p-4 text-center bg-white">
                    <div class="my-3">
                        <i class="fas fa-file-code fa-3x mb-3" style="color: #0F172A;"></i>
                        <h5 class="fw-bold text-dark">Téléverser un nouveau firmware "SERVER SMS"</h5>
                        <p class="text-muted small">
                            Sélectionnez et envoyez un fichier binaire (<code>.bin</code>) pour mettre à jour vos modules distants en toute sécurité.
                        </p>
                    </div>

                    {# Actions en boutons Bootstrap (Remplacement de la balise dialog/menu native) #}
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="#" class="btn btn-outline-secondary px-4 font-weight-bold">
                            <i class="fas fa-times me-1"></i> Annuler
                        </a>
                        <a href="{{ path('app_ota_upload') }}" class="btn text-white font-weight-bold shadow-sm px-4" style="background-color: #0F172A; border-left: 3px solid #D4AF37;">
                            <i class="fas fa-cloud-upload-alt me-2" style="color: #D4AF37;"></i> Téléverser
                        </a>
                    </div>
                </div>

                {# Pied de carte #}
                <div class="card-footer bg-light p-3 text-center">
                    <small class="text-muted"><i class="fas fa-shield-alt me-1 text-primary"></i> Transfert sécurisé via HTTPS / TLS</small>
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}