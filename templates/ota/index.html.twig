{% extends 'base.html.twig' %}

{% block title %}Mise à jour OTA — ESP32{% endblock %}

{% block body %}
{# {% include "navbar.html.twig" %} #}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            {# Affichage des messages Flash #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                        <i class="fas {{ label == 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle' }} me-2"></i>
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                    <h2 class="h3 fw-bold mb-1">
                        <i class="fas fa-microchip me-2"></i>Mise à jour ENCODER via OTA
                    </h2>
                    <p class="mb-0 text-white-50">Téléversez un fichier binaire (Code ou Système de fichiers Data)</p>
                </div>

                <div class="card-body p-4 p-md-5">

                    {{ form_start(form, {'attr': {'id': 'otaUploadForm', 'enctype': 'multipart/form-data'}}) }}

                        {# Affichage des erreurs globales du formulaire #}
                        {% if form_errors(form) %}
                            <div class="alert alert-danger mb-4">
                                {{ form_errors(form) }}
                            </div>
                        {% endif %}

                        {# Champ Type de mise à jour (Firmware vs Data) #}
                        {% if form.type is defined %}
                            <div class="mb-4">
                                {{ form_label(form.type, 'Type de mise à jour', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-layer-group"></i></span>
                                    {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                                </div>
                                <div class="form-text">
                                    Choisissez <strong>Firmware (.bin)</strong> pour le code C++ ou <strong>Data LittleFS/SPIFFS (.bin)</strong> pour l'interface web.
                                </div>
                                {{ form_errors(form.type) }}
                            </div>
                        {% endif %}

                        {# Champ Sélecteur de fichier (.bin) #}
                        <div class="mb-4">
                            {% if form.binaryFile is defined %}
                                {{ form_label(form.binaryFile, 'Fichier Binaire (.bin)', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                {{ form_widget(form.binaryFile, {'attr': {'class': 'form-control', 'accept': '.bin'}}) }}
                                {{ form_errors(form.binaryFile) }}
                            {% elseif form.file is defined %}
                                {{ form_label(form.file, 'Fichier Binaire (.bin)', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                {{ form_widget(form.file, {'attr': {'class': 'form-control', 'accept': '.bin'}}) }}
                                {{ form_errors(form.file) }}
                            {% else %}
                                {{ form_rest(form) }}
                            {% endif %}
                            <div class="form-text">Format accepté : fichier binaire compilé <code>.bin</code>.</div>
                        </div>

                        {# Barre de progression d'envoi (masquée par défaut) #}
                        <div id="progressContainer" class="mb-4 d-none">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-bold small text-muted">Envoi en cours...</span>
                                <span id="progressText" class="fw-bold small text-primary">0%</span>
                            </div>
                            <div class="progress" style="height: 12px;">
                                <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%;"></div>
                            </div>
                        </div>

                        {# Bouton d'action #}
                        <div class="d-grid mt-4">
                            <button type="submit" id="submitBtn" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                                <i class="fas fa-cloud-upload-alt me-2"></i> Démarrer la mise à jour
                            </button>
                        </div>

                    {{ form_end(form) }}

                </div>

                <div class="card-footer bg-light text-center py-3 rounded-bottom-4">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i> Ne débranchez pas l'ESP32 pendant la mise à jour OTA.
                    </small>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    // Animation visuelle lors de la soumission du formulaire
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('otaUploadForm');
        const submitBtn = document.getElementById('submitBtn');
        const progressContainer = document.getElementById('progressContainer');

        if (form) {
            form.addEventListener('submit', function() {
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Téléversement en cours...';
                }
                if (progressContainer) {
                    progressContainer.classList.remove('d-none');
                }
            });
        }
    });
</script>
{% endblock %}