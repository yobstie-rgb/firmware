{% extends 'base.html.twig' %}

{% block title %}Téléverser un Firmware OTA{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Mise à jour OTA - ESP32</h1>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} mt-3">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card mt-3">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_widget(form) }}
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}